// 圖片模型（一對多）
model ProductImage {
  id        String   @id @default(cuid())
  url       String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Project {
  id                  String   @id @default(cuid())
  title               String
  description         String?
  status              ProjectStatus @default(PENDING)
  customerId          String
  customer            User     @relation(fields: [customerId], references: [id])
  deadline    DateTime?
  assignedEmployeeId  String?
  assignedEmployee    User?    @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  quotes              Quote[]
  reports             Report[]
  progresses ProjectProgress[]

  conversation        Conversation?  // 反向關聯

  createdAt           DateTime @default(now())
  isCompleted Boolean @default(false)  // 新增：是否完成
}

enum ProjectStatus {
  PENDING
  ASSIGNED
  COMPLETED
}

model Quote {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  amount    Float
  details   String?
  invoice   Invoice? 
  createdAt DateTime @default(now())
}

model Conversation {
  id        String    @id @default(cuid())
  customerId String
  customer   User      @relation(fields: [customerId], references: [id])

  // ⬇️ 新增以下兩行
  projectId  String?    @unique    // 一個任務只會有一個對話
  project    Project?   @relation(fields: [projectId], references: [id])

  messages   Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderRole     Role
  content        String
  imageUrl       String?
  createdAt      DateTime     @default(now())

  // ▼▼▼ 請新增以下兩行 (對應 User.messages) ▼▼▼
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  // ▲▲▲ 請新增以上兩行 ▲▲▲
  
  senderType     SenderType?   // 新增欄位

    // ⭐ 新增：支援文件附件
  fileName  String?    // 原始檔案名稱（如 report.pdf）
  fileSize  Int?       // 檔案大小（bytes）
  fileType  String?    // MIME 類型（如 application/pdf）
  // ⭐ 新增：標記特殊訊息類型
  messageType MessageType @default(NORMAL)
}

// ⭐ 新增：訊息類型枚舉
enum MessageType {
  NORMAL        // 一般訊息
  QUOTE         // 報價單
  PROGRESS      // 進度更新
  SYSTEM        // 系統通知
}


// ⭐ 新增：專案進度模型
model ProjectProgress {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       String   // 自定義階段名稱（如「報價中」「生產中」「已出貨」）
  description String?  // 備註說明
  updatedById String
  updatedBy   User     @relation("ProgressUpdates", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  @@index([projectId, createdAt])
}

enum SenderType {
  USER
  SYSTEM
}

model Broadcast {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  videoUrl  String?   // ← 新增這一行
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  scheduledAt DateTime?  // ← 新增：排程發布時間（null 表示立即發布）

  isDailyPromotion Boolean @default(false)
  broadcastLogs   BroadcastLog[]

  status          BroadcastStatus  @default(DRAFT)
  publishedAt     DateTime?        // 實際發布時間
   // ⭐ 新增：是否顯示在客戶頁面
  isPinned  Boolean @default(false)
}

enum BroadcastStatus {
  DRAFT      // 草稿（編輯中，不會推送）
  PUBLISHED  // 已發布（正常推送）
  PAUSED     // 已暫停（暫停推送）
  ARCHIVED   // 已封存（停止推送）
}



enum NotificationChannel {
  EMAIL
  WHATSAPP
}
enum NotificationStatus {
  PENDING
  SUCCESS
  FAILED
}
model BroadcastLog {
  id              String             @id @default(cuid())
  broadcastId     String
  broadcast       Broadcast          @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  customerId      String
  customer        User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel         NotificationChannel
  status          NotificationStatus @default(PENDING)
  errorMessage    String?            // 失敗原因
  sentAt          DateTime?          // 實際發送時間
  createdAt       DateTime           @default(now())
  @@index([broadcastId, status])
  @@index([customerId])
}

model Report {
  id        String     @id @default(cuid())
  type      ReportType
  title     String     // 新增標題欄位，便於管理
  content   String
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  projectId String?
  project   Project?   @relation(fields: [projectId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum ReportType {
  SALES
  PRODUCT
  AMOUNT
  BROADCAST
  EMPLOYEE
}

model SalesActivity {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}


model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String?  // 可選：如 #FF0000，用來顯示標籤顏色
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customers   CustomerTag[] // 多對多關聯
}

model CustomerTag {
  customerId String
  tagId      String
  customer   User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String   @unique
  code      String   // 6 位數字
  userId    String?  // 若已有帳號則關聯，首次註冊可為 null
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  expiresAt DateTime
  attempts  Int      @default(0) // 防暴力破解
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}
model Invoice {
  id            String          @id @default(cuid())
  invoiceNumber String          @unique  // 自動產生，如 INV-20250609-0001
  quoteId       String          @unique  // 一對一：一個報價單只能轉一張發票
  quote         Quote           @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  status        InvoiceStatus   @default(PENDING)
  issuedDate    DateTime        @default(now())
  dueDate       DateTime?       // 到期日
  paidDate      DateTime?       // 付款日
  // 可獨立修改金額（因發票可能與報價有微調）
  amount        Float
  details       String?         // 發票備註
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}